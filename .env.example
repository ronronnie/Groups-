# Server-only values. Never prefix these with NEXT_PUBLIC_.
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/groups?sslmode=require"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID="replace-with-google-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-client-secret"
OPENAI_API_KEY="replace-with-openai-api-key"
OPENAI_MODEL="gpt-5-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
ABLY_API_KEY="replace-with-ably-api-key"

# Public browser value. This contains an origin, not a secret.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
